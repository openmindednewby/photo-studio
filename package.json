{
  "name": "@dloizides/photo-studio",
  "version": "0.1.0",
  "description": "On-device photo capture and clean-up for RN-web: live camera with fallback, gallery and drop, crop, rotate, edge detection with perspective straighten, filters, and a side-by-side slot, run in a Web Worker.",
  "keywords": [
    "react-native-web",
    "camera",
    "crop",
    "perspective",
    "document-scanner",
    "image-filters",
    "web-worker"
  ],
  "author": "dloizides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/photo-studio.git"
  },
  "homepage": "https://github.com/openmindednewby/photo-studio#readme",
  "bugs": {
    "url": "https://github.com/openmindednewby/photo-studio/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./worker": "./dist/photo-studio-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "security:audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "version": "npm run build"
  },
  "dependencies": {
    "@dloizides/image-decode": "^0.1.2"
  },
  "peerDependencies": {
    "@dloizides/ui-buttons": ">=1.23.0",
    "@dloizides/ui-feedback": ">=1.12.0",
    "@dloizides/ui-layout": ">=1.26.4",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@dloizides/ui-buttons": "^1.23.0",
    "@dloizides/ui-feedback": "^1.20.0",
    "@dloizides/ui-layout": "^1.38.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.32",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
